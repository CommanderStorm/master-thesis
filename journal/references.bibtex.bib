  langid = {english},
  file = {/home/frank/Zotero/storage/S6SU6CZ3/Tremmel - 2023 - COMTILES A CASE STUDY OF A CLOUD OPTIMIZED TILE ARCHIVE FORMAT FOR DEPLOYING PLANET-SCALE TILSETS I.pdf}
