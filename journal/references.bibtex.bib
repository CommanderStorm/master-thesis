  author = {Christophe, Sidonie and Dum{\'e}nieu, Bertrand and Masse, Antoine and Hoarau, Charlotte and Ory, J{\'e}r{\'e}mie and Br{\'e}dif, Mathieu and Lecordix, Fran{\c c}ois and Mellado, Nicolas and Turbet, J{\'e}r{\'e}mie and Loi, Hugo and Hurtut, Thomas and Vanderhaeghe, David and Vergne, Romain and Thollot, Jo{\"e}lle},
