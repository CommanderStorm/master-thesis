%% load `subcaption` in main.tex instead. Original preserved as subfigure.sty.orig.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{subfigure}[2026/06/22 no-op stub; use subcaption instead]
\providecommand{\subfigure}[2][]{#2}
\providecommand{\subtable}[2][]{#2}
\providecommand{\subref}[1]{\ref{#1}}
